# Copy to .env at the repository root. API always binds to loopback.
# No model credentials are needed for MOCK. npm run demo ignores this file.
# Shell environment overrides these defaults. Never put secrets in VITE_* variables.
API_PORT=3001
# Optional Vite proxy target, must match API_PORT.
# API_TARGET=http://127.0.0.1:3001
# Defaults to ~/.worktreeos. Use an absolute directory outside the source tree.
# WORKTREEOS_DATA_DIR=C:/Users/your-name/.worktreeos
# Managed worktrees default to WORKTREEOS_DATA_DIR/worktrees, outside registered repos.
# WORKTREEOS_WORKTREE_DIR=C:/Users/your-name/.worktreeos/worktrees
# Total scheduler concurrency: 1 or 2. Tasks in the same repository serialize.
WORKTREEOS_CONCURRENCY=2
# Bounded outstanding run budget = concurrency + queue capacity.
WORKTREEOS_QUEUE_CAPACITY=32
# Includes preparation and execution; timeout aborts the provider, without retry.
WORKTREEOS_RUN_TIMEOUT_MS=900000
