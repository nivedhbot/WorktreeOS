{
  "name": "worktreeos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predemo": "npm run build",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:smoke": "npm run demo -- --smoke",
    "seed:dev": "npm run build -w @worktreeos/shared && npm run seed -w @worktreeos/api --",
    "predev": "npm run build -w @worktreeos/shared",
    "dev": "concurrently --kill-others --names shared,api,web \"npm run dev -w @worktreeos/shared\" \"npm run dev -w @worktreeos/api\" \"npm run dev -w @worktreeos/web\"",
    "build": "npm run build -w @worktreeos/shared && npm run build -w @worktreeos/api && npm run build -w @worktreeos/web",
    "pretypecheck": "npm run build -w @worktreeos/shared",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.e2e.json",
    "pretest": "npm run build -w @worktreeos/shared",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
